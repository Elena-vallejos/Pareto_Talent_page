# --- GoHighLevel form (public by design: it is the embed URL, not an API key) ---
# Defaults to the Pareto Talent lead form if left empty.
# Format: https://api.leadconnectorhq.com/widget/form/<FORM_ID>
NEXT_PUBLIC_GHL_FORM_EMBED_URL=https://api.leadconnectorhq.com/widget/form/jzahKmKx3IEwHLE4Jri4

# Shows a small "TEST MODE" badge and logs analytics events to the console. Never "true" in production.
NEXT_PUBLIC_TEST_MODE=false

# Production domain, used for canonical URL and Open Graph links (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Footer links (optional). Use full URLs or mailto: links.
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_CONTACT_URL=
